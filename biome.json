{
	"$schema": "https://biomejs.dev/schemas/2.4.7/schema.json",
	"formatter": {
		"enabled": true,
		"lineWidth": 140,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true
	},
	"files": {
		"includes": [
			"**/*.js",
			"**/*.jsx",
			"**/*.ts",
			"**/*.tsx",
			"**/*.json",
			"!!**/node_modules",
			"!!**/.next",
			"!!**/out",
			"!!**/dist",
			"!!**/build"
		]
	}
}
